# Optional. Browser-delivered ion tokens are public; restrict to read-only assets
# and permitted URLs in Cesium ion. Never put a secret/admin token here.
VITE_CESIUM_ION_TOKEN=

# Server-only values. Copy this file to .env.local; never prefix these with VITE_.
# Use your Atlas database-user connection string and allow your development IP.
MONGODB_URI=
MONGODB_DB=first_contact
GEMINI_API_KEY=
# Optional model override; the service documents its default in /api/status.
GEMINI_MODEL=
